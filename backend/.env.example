# ==============================================================================
# InterviewQuest AI Environment Configuration
# ==============================================================================

# Application Metadata
PROJECT_NAME="InterviewQuest AI"
ENVIRONMENT="development"
DEBUG=true

# Database Configuration (PostgreSQL / PGAdmin / Supabase)
# For local PostgreSQL with asyncpg:
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/interviewquest
# Synchronous DB URL for Alembic migrations and ingestion:
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/interviewquest

# Security & Authentication
JWT_SECRET=09d25e094faa6ca2556c818166b7a9563b93f7099f6f0f4caa6cf63b88e8d3e7
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Embedding Strategy & Vector Model
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# LLM Configuration (Google Gemini)
# Paste your Gemini API key here when you are ready:
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
GEMINI_MAX_CALLS_PER_SESSION=5
GEMINI_MAX_TOKENS_PER_CALL=1024

# Web Fallback Configuration
WEB_SEARCH_ENABLED=true
TAVILY_API_KEY=

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://localhost:8000"]
